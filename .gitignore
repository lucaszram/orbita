# Dependencies
node_modules/
.pnpm-store/

# Expo / React Native local state
.expo/
.expo-shared/
dist/
web-build/

# Exports temporales de las auditorías nativas: se generan para auditar el
# bundle y se retiran en la misma corrida. `dist/` ya está arriba y es la salida
# canónica del export web.
dist-ios/
dist-android/

# Evidencia local de auditoría (capturas, logs, comparaciones, herramientas de
# la corrida). Son cientos de megas que existen sólo en esta máquina y no forman
# parte del producto: nada de `.local/` tiene seguimiento hoy, y no debe entrar
# por un `git add -A` distraído. NO se borra: vive fuera de git a propósito.
.local/

# Native build output
android/
ios/

# Environment
.env
.env.*
!.env.example

# Logs and OS files
*.log
.DS_Store

# TypeScript
*.tsbuildinfo

# Raw source assets — not used by the web build (kept locally, out of git)
assets/orbita/higgsfield/archive-7/
assets/orbita/higgsfield/archive-9/
assets/orbita/higgsfield/archive-10/inbox/
assets/orbita/higgsfield/archive-10/needs-review/
assets/orbita/higgsfield/archive-10/contact-sheets/
.vercel
.env*


# Local tooling and repository metadata
.git/
node_modules/
.pnpm-store/
.expo/
.expo-shared/

# Local environment and logs
.env
.env.*
!.env.example
*.log
.DS_Store
*.tsbuildinfo

# Generated/native outputs
android/
ios/
dist/
# Exports temporales de las auditorías nativas: se generan para auditar el
# bundle y se retiran en la misma corrida. `.gitignore` ya los excluía, pero EAS
# NO lee `.gitignore` cuando existe este archivo, así que sin estas dos líneas
# un export a medio limpiar viajaba dentro del tarball del build.
dist-ios/
dist-android/
web-build/

# Evidencia local de auditoría: capturas, logs, comparaciones y herramientas de
# la recertificación. Son cientos de megas que existen sólo en esta máquina y no
# forman parte del producto. NO se borra —vive fuera de git a propósito— pero
# tampoco tiene por qué subir a un servidor de builds.
.local/


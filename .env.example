# ─── Web pública (build de Vercel) ────────────────────────────────────────────
# Todo lo que empieza con EXPO_PUBLIC_ queda EMBEBIDO en el bundle y es visible
# para cualquiera: acá sólo van claves públicas, nunca secretos.
#
# URL del deployment de Convex que sirve a la web pública. Producción usa el
# deployment prod; dev/preview usan el de desarrollo. Sin esta variable la app
# no muestra contenido: renderiza el estado "no disponible", no datos de muestra.
EXPO_PUBLIC_CONVEX_URL=
# Publishable key de Clerk. `pk_live_…` en la web pública (con el dominio
# canónico configurado en Clerk); `pk_test_…` en dev/preview, que además pinta el
# badge "Development mode".
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# "Continuar con Google" en el alta. Sólo web y sólo con el valor exacto "true";
# requiere tener el proveedor Google habilitado en el dashboard de Clerk. Sin
# esta variable el alta por email queda entera y el botón no se muestra.
EXPO_PUBLIC_ORBITA_GOOGLE_AUTH=
# Rutea /studio, /lab y /backoffice. En la web pública de producción tiene que
# quedar AUSENTE (o distinta de "true"): estas superficies son internas y un
# deploy que la setee las publica. El default es cerrado.
EXPO_PUBLIC_ORBITA_INTERNAL_TOOLS=
CLERK_JWT_ISSUER_DOMAIN=
ORBITA_BACKOFFICE_ALLOWED_EMAILS=
# Local/dev escape hatch only. Keep false in shared/prod deployments — and
# always false in the deployment that serves the public web.
ORBITA_BACKOFFICE_ALLOW_ALL=false
# Public-dev Home Lab. Keep disabled unless intentionally testing /lab. The
# public web build must ship with every internal surface off: the client flag
# above unset, and these server-side switches false/empty.
ORBITA_PUBLIC_LAB_ENABLED=false
ORBITA_PUBLIC_LAB_KEY=

# Server-side only. Set these in Convex env, never in client-exposed EXPO_PUBLIC envs.
ASTROLOGY_API_USER_ID=
ASTROLOGY_API_KEY=
ASTROLOGY_API_BASE_URL=https://json.astrologyapi.com/v1
ASTROLOGY_API_LANGUAGE=en
ASTROLOGY_API_HOUSE_SYSTEM=placidus
# Optional until AstrologyAPI shares the exact Location API endpoint for the account.
ASTROLOGY_API_LOCATION_URL=
# Optional future endpoint for provider-confirmed long windows like "hasta marzo" or "vuelve en 2027".
ASTROLOGY_API_LONG_RANGE_URL=

# Optional LLM layer for /lab. Keep disabled unless testing Gateway spend.
ORBITA_LLM_ENABLED=false
AI_GATEWAY_API_KEY=
# Use Vercel AI Gateway provider/model format, for example anthropic/claude-sonnet-4.6.
ORBITA_LLM_MODEL=
ORBITA_LLM_DAILY_PROMPT_VERSION=orbita-lab-daily-home-llm-v1
ORBITA_LLM_DAILY_CACHE_VERSION=orbita-llm-daily-cache-v1
ORBITA_LLM_NATAL_PROMPT_VERSION=orbita-natal-profile-llm-v1
ORBITA_LLM_NATAL_CACHE_VERSION=orbita-natal-profile-cache-v1

# Pagos — server-side only, set in Convex env (nunca en EXPO_PUBLIC).
# Stripe (web). Test mode primero (sk_test_… / whsec_…), luego live.
# El valor seguro por defecto es off. Sólo usar live después del Gate B aprobado.
COMMERCE_MODE=off
ORBITA_ENVIRONMENT=development
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Oferta web pública: una suscripción mensual. El importe se administra en
# Stripe y nunca se escribe en el frontend.
STRIPE_PRICE_MONTHLY=
# Sólo para reconocer suscripciones web históricas durante la transición. No
# se usan para crear checkouts nuevos y pueden quedar vacías si nunca hubo live.
STRIPE_PRICE_WEEKLY=
STRIPE_PRICE_YEARLY=
STRIPE_AUTOMATIC_TAX=false
# RevenueCat (app). Mismo string exacto que el Authorization value del webhook en el dashboard RC.
REVENUECAT_WEBHOOK_AUTH=
# Base URL de la web para redirects de Stripe Checkout / Customer Portal.
WEB_APP_URL=

# Client-exposed (app). RevenueCat public SDK keys por plataforma.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=

# Legacy until Supabase is fully retired.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
